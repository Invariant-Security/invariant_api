# Copy this file to .env and fill in the real values. .env is gitignored --
# never commit real credentials.

DATABASE_URL=postgresql://invariant:invariant_dev@localhost:5435/invariant

# Origins invariant_api's CORS allows (comma-separated).
INVARIANT_API_CORS_ORIGINS=http://localhost:5173

# Only needed if invariant_assessment/invariant_ingestion/invariant_discovery
# aren't at the docker-compose default (http://<service>:8000).
INVARIANT_ASSESSMENT_URL=http://assessment:8000
INVARIANT_INGESTION_URL=http://ingestion:8000
INVARIANT_DISCOVERY_URL=http://discovery:8000

# Assina o cookie de sessão do admin (routes/auth.py). No modo appliance,
# o postinst do .deb gera isso uma vez com `openssl rand -hex 32` e grava
# em /etc/invariant/.env -- nunca escolha esse valor à mão em produção.
INVARIANT_API_SECRET_KEY=

# Pix checkout (routes/billing.py). Access token from an Invariant Mercado
# Pago business account -- see https://www.mercadopago.com.br/developers.
# Without this set, POST /billing/checkout returns 503 instead of failing
# with a confusing error.
MERCADO_PAGO_ACCESS_TOKEN=
# Secret configured alongside the webhook URL in the Mercado Pago dashboard
# -- used to verify the x-signature header on POST /webhook/mercadopago.
MERCADO_PAGO_WEBHOOK_SECRET=
# Public HTTPS base URL of this deployment. Only used to build the Pix
# payment's notification_url -- Mercado Pago rejects http/localhost, so
# this is skipped entirely (falls back to whatever notification URL is
# configured in the MP dashboard) unless it starts with https://.
INVARIANT_API_BASE_URL=
